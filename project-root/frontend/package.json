{
  "name": "my-ui-vanilla-ts-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:ts && npm run copy:assets",
    "build:ts": "tsc -p tsconfig.json",
    "build:css": "tailwindcss -c tailwind.config.js -i ./src/styles/tailwind.css -o ./dist/styles.css",
    "copy:assets": "node ./scripts/copy-assets.js",
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:ts\" \"npm:dev:serve\"",
    "dev:ts": "tsc -p tsconfig.json --watch",
    "dev:css": "tailwindcss -c tailwind.config.js -i ./src/styles/tailwind.css -o ./dist/styles.css --watch",
    "dev:serve": "live-server --port=5173 --watch=dist,index.html,assets"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "live-server": "^1.2.2",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.6.3"
  }
}